---
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import "../styles/globals.css";
import "../styles/fonts.css";
import { cn } from "@/lib/utils";
import { ViewTransitions } from "astro:transitions";
import { SEO } from "astro-seo";
import { CalendarCheck } from "lucide-react";
import { SimpleAnalytics } from "astro-simpleanalytics-plugin";
import { getHomeSchema, getPageSchema } from "@/lib/schema";
import { ROUTES } from "@/routes";

interface Props {
  title: string;
  description: string;
  withPadding?: boolean;
  className?: string;
  ignoreViewTransitions?: boolean;
  /** Page name used in the BreadcrumbList structured data */
  breadcrumb?: string;
  noindex?: boolean;
}
const {
  title,
  description,
  withPadding = true,
  ignoreViewTransitions = false,
  className = {},
  breadcrumb,
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL("/og.jpg", Astro.site).href;
const isHome = Astro.url.pathname === "/";
const bookingPath = ROUTES.DISPO_TARIFS.getPath({});
const showBookingCta =
  Astro.url.pathname.replace(/\/$/, "") !== bookingPath.replace(/\/$/, "");
const schema = isHome
  ? getHomeSchema()
  : breadcrumb
    ? getPageSchema({ name: breadcrumb, url: canonical })
    : null;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <SEO
      title={title}
      description={description}
      canonical={canonical}
      noindex={noindex}
      openGraph={{
        basic: {
          title,
          type: "website",
          image: ogImage,
          url: canonical,
        },
        optional: {
          description,
          locale: "fr_FR",
          siteName: "Gîte Là-Haut",
        },
        image: {
          width: 1600,
          height: 630,
          alt: "Gîte Là-Haut aux Fourgs",
        },
      }}
      twitter={{
        card: "summary_large_image",
        site: "@nathanbrachotte",
        creator: "@nathanbrachotte",
        title,
        description,
        image: ogImage,
      }}
      extend={{
        meta: [{ name: "author", content: "Nathan Brachotte" }],
      }}
    />
    {
      schema && (
        <script type="application/ld+json" set:html={JSON.stringify(schema)} />
      )
    }
    {ignoreViewTransitions ? null : <ViewTransitions />}
  </head>
  <body
    class={cn("min-h-screen flex flex-col items-stretch min-w-full", {
      "pb-16 lg:pb-0": showBookingCta,
    })}
  >
    <Header />
    <div
      class={cn(
        "flex-1",
        {
          "px-4 md:px-8 mb-8 mt-8": withPadding,
        },
        className,
      )}
    >
      <slot />
    </div>
    <Footer />
    {
      showBookingCta && (
        <div class="lg:hidden fixed bottom-0 inset-x-0 z-40 bg-white/95 border-t border-highlight p-2 flex justify-center">
          <a
            href={bookingPath}
            class="w-full max-w-sm inline-flex items-center justify-center gap-2 rounded-md bg-highlight text-highlight-foreground font-semibold text-sm py-2.5 px-4 shadow"
          >
            <CalendarCheck className="size-4" aria-hidden="true" />
            Réserver / Voir les disponibilités
          </a>
        </div>
      )
    }
    <SimpleAnalytics collectDNT />
  </body>
</html>

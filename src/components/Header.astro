---
import {
  AccueilLink,
  PlanLink,
  DecouvrirLaRegionLink,
  DispoLink,
} from "@/components/Buttons";
import { Image } from "astro:assets";
import { MobileMenu } from "@/components/MobileMenu";
import { GiteLogoWrapper } from "@/components/GiteLogoWrapper";

const activePath = Astro.url.pathname;
---

<header class="sticky top-0 z-40 bg-white shadow-md w-full p-3 lg:p-6">
  <div class="container mx-auto flex justify-between items-center gap-2">
    <div class="flex flex-nowrap items-center min-w-0">
      <div class="mr-2 sm:mr-4">
        <GiteLogoWrapper />
      </div>
      <div
        class="flex flex-row flex-1 min-w-12 sm:min-w-36 justify-start gap-1 sm:gap-2"
      >
        <Image
          src="/2-etoiles.webp"
          alt="Gîte 2 épis"
          class="h-12 lg:h-[50px] w-auto object-contain shrink-0"
          width={250}
          height={250}
        />
      </div>
    </div>
    <MobileMenu activePath={activePath} client:load />
    <nav class="hidden lg:flex flex-1 justify-end gap-0">
      <AccueilLink activePath={activePath} client:load />
      <DispoLink activePath={activePath} client:load />
      <PlanLink activePath={activePath} client:load />
      <DecouvrirLaRegionLink activePath={activePath} client:load />
    </nav>
  </div>
</header>

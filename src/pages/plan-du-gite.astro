---
import Layout from "@/layouts/Layout.astro";
import { LandingH1 } from "@/components/Typography";
// import { Image } from "astro:assets";
import { ZoomedImage } from "@/components/ZoomedImage";
import { SEO_META } from "@/data.constants";
import Container from "@/components/Container.astro";
import ContactForm from "@/components/ContactForm.astro";
import Card from "@/components/Card.astro";
import GiteAccessInfo from "@/components/GiteAccessInfo.astro";
import RoomDetails from "@/components/RoomDetails.astro";
import { Image } from "astro:assets";

const LABEL = "Plan du Gîte Là-Haut";
---

<Layout
  title={SEO_META.PLAN_DU_GITE.title}
  description={SEO_META.PLAN_DU_GITE.description}
  breadcrumb="Plan du Gîte"
>
  <Container>
    <LandingH1 className="text-center text-4xl lg:text-5xl">{LABEL}</LandingH1>
    <Card className="mt-4">
      <div class="flex flex-col justify-center gap-4 mt-4 items-center">
        <div class="w-full lg:w-2/3">
          <ZoomedImage client:idle>
            <Image
              src="/gite/plan.webp"
              alt="Plan du Gîte Là-Haut : 2 chambres, salle de bain, cuisine et salon"
              class={"w-full h-auto object-cover"}
              width={1600}
              height={1115}
              loading="eager"
              fetchpriority="high"
              loading="eager"
              fetchpriority="high"
            />
          </ZoomedImage>
        </div>
        <GiteAccessInfo />
      </div>
    </Card>
    <RoomDetails />
  </Container>
  <Container>
    <ContactForm />
  </Container>
</Layout>

---
import Layout from "@/layouts/Layout.astro";
import { LandingH2 } from "@/components/Typography";
// import { Image } from "astro:assets";
import { ZoomedImage } from "@/components/ZoomedImage";
import { SEO_META } from "@/data.constants";
import Container from "@/components/Container.astro";
import ContactForm from "@/components/ContactForm.astro";
import Card from "@/components/Card.astro";
import GiteAccessInfo from "@/components/GiteAccessInfo.astro";
import { Image } from "astro:assets";

const LABEL = "Plan du Gîte";
---

<Layout
  title={SEO_META.PLAN_DU_GITE.title}
  description={SEO_META.PLAN_DU_GITE.description}
>
  <Container>
    <LandingH2 className="text-center">{LABEL}</LandingH2>
    <Card className="mt-4">
      <div class="flex flex-col justify-center gap-4 mt-4 items-center">
        <div class="lg:w-2/3">
          <ZoomedImage client:idle>
            <Image
              src="/gite/plan.webp"
              alt={LABEL}
              class={"w-full h-full object-cover"}
              width={1250}
              height={2250}
            />
          </ZoomedImage>
        </div>
        <GiteAccessInfo />
      </div>
    </Card>
  </Container>
  <Container>
    <ContactForm />
  </Container>
</Layout>
